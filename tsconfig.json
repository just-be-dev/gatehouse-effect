{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    // Module system (library)
    "target": "ES2022",
    "module": "NodeNext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    // Type checking only — tsconfig.build.json emits
    "noEmit": true,

    // Type safety
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Performance
    "skipLibCheck": true,

    // Effect language service, run by the Effect-patched tsrs (`effect-tsgo patch --tsrs`)
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["tests/**/*.test.ts"],
            "options": { "allowedUnstableApis": ["@effect/vitest"] }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "oxlint.config.ts", "vitest.config.ts"]
}
