{
  "name": "gatehouse-effect",
  "version": "1.0.1",
  "description": "A TypeScript library for building and managing authorization policies.",
  "keywords": [
    "authorization",
    "gatehouse",
    "policy",
    "typescript"
  ],
  "homepage": "https://github.com/9Morello/gatehouse-ts",
  "license": "Apache-2.0",
  "author": "Justin Bennett <oss@just-be.dev>",
  "contributors": [
    "gr4vityWall (https://github.com/9Morello)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9Morello/gatehouse-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/gatehouse.js",
  "module": "src/gatehouse.ts",
  "types": "dist/gatehouse.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gatehouse.d.ts",
      "default": "./dist/gatehouse.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "docs": "typedoc",
    "deploy": "bunx @just-be/deploy",
    "prepare": "effect-tsgo patch --tsrs --no-typescript"
  },
  "dependencies": {
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@effect/vitest": "4.1.5",
    "@mpsuesser/oxlint-plugin-effect": "0.6.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typedoc": "0.28.20",
    "vitest": "5.1.1"
  },
  "overrides": {
    "effect": "4.1.5"
  }
}
